# Tableau connection settings for tableau-rest-api-starter-pack.
#
# Copy this file to .env and fill in your values:
#     cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# Base URL of your Tableau Cloud pod or Tableau Server (no path needed).
#   Tableau Cloud:  https://10ax.online.tableau.com
#   Tableau Server: https://tableau.mycompany.com
TABLEAU_SERVER_URL=https://your-pod.online.tableau.com

# Site content URL: the part after /site/ in your browser's address bar.
#   https://10ax.online.tableau.com/#/site/acme-analytics/home  ->  acme-analytics
# Tableau Server only: leave blank to use the Default site.
TABLEAU_SITE_NAME=your-site-name

# Personal access token, created under My Account Settings > Personal Access Tokens.
TABLEAU_PAT_NAME=your-pat-name
TABLEAU_PAT_SECRET=your-pat-secret

# ---------------------------------------------------------------- optional

# REST API version to use, e.g. 3.29. Leave blank to auto-detect from the server.
TABLEAU_API_VERSION=

# TLS certificate checking. Leave as true for Tableau Cloud.
# For Tableau Server with a self-signed certificate, set this to the path of
# your CA bundle file (preferred) or to false.
TABLEAU_VERIFY_SSL=true

# Folder the workbook picker opens in. If blank, it opens
# ~/Documents/My Tableau Repository/Workbooks when that exists, otherwise
# the folder you run the script from.
DEFAULT_WORKBOOK_DIR=
